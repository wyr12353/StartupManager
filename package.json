{
  "name": "startupmanager",
  "private": true,
  "version": "0.2.0",
  "description": "Windows 启动项管理器",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "npm run version:check && npm run build && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "version:check": "node tools/check-version.mjs",
    "version:sync": "node tools/sync-version.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.59.0",
    "@tauri-apps/api": "^2",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.13",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
