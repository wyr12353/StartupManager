{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "启动项管理器",
  "mainBinaryName": "StartupManager",
  "version": "0.2.0",
  "identifier": "com.w1509.startupmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "启动项管理器",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#0E0E1000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "w1509",
    "copyright": "Copyright © 2026 w1509",
    "shortDescription": "Windows 启动项管理器",
    "longDescription": "扫描并可逆地启用或禁用 Windows 启动项。",
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "upgradeCode": "030ec29e-7afc-544d-9bd1-3a440fdfef21",
        "language": "zh-CN"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
